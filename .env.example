# DEMEX — Gmail ingest credentials
# ---------------------------------
# Copy this file to ".env" (same folder) and fill in the two values below.
# The bridge loads .env automatically; .env is git-ignored so it never commits.
#
# HOW TO GET A GMAIL APP PASSWORD (one time):
#   1. Go to  https://myaccount.google.com/security
#   2. Turn ON "2-Step Verification" (App Passwords require it).
#   3. Open  https://myaccount.google.com/apppasswords
#   4. App name: type "DEMEX"  ->  Create.
#   5. Google shows a 16-character password (e.g. "abcd efgh ijkl mnop").
#      Paste it below. Spaces are fine — they are stripped automatically.
#   6. This is NOT your normal Gmail password and can be revoked anytime.

DEMEX_GMAIL_USER=you@yourcompany.com
DEMEX_GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Optional: change the bridge port (must match the URL you open).
# DEMEX_BRIDGE_PORT=8765
